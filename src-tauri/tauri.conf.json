{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viethoagame Manager",
  "version": "0.1.0",
  "identifier": "com.viethoagame.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Viethoagame Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Quản lý và cài đặt bản việt hóa game",
    "longDescription": "Viethoagame Manager - Công cụ quản lý và cài đặt các bản việt hóa game cho Windows một cách dễ dàng.",
    "windows": {
      "wix": {
        "language": ["vi-VN", "en-US"]
      },
      "nsis": {
        "languages": ["Vietnamese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/viethoagame/viethoagame-manager/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}